{
  "name": "dsh-todo-files",
  "version": "1.1.2",
  "description": "DSH sidebar panel for personal todos: add, edit, tag, split into subtasks and repeat them from the panel, with a trash, backups and a date-aware list — or do it all by talking to the agent.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "todo",
    "sidebar"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Afei027/dsh-todo-files.git"
  },
  "bugs": {
    "url": "https://github.com/Afei027/dsh-todo-files/issues"
  },
  "homepage": "https://github.com/Afei027/dsh-todo-files#readme",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-sidebar"]
    }
  }
}
